discovery.relabel "selected" {
  targets = discovery.docker.local.targets

  // Seleciona somente a aplicação API do RouteXFlow.
  rule {
    source_labels = ["__meta_docker_container_label_coolify_resourceName"]
    regex         = "api-routexflow-prod"
    action        = "keep"
  }

  // Mantém o PostgreSQL da aplicação.
  rule {
    source_labels = ["__meta_docker_container_label_coolify_resourceName"]
    regex         = "banco-postgres-prod"
    action        = "keep"
  }

  // Nome do container para pesquisa no Grafana.
  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/(.*)"
    target_label  = "container"
    replacement   = "$1"
  }

  // Identificação do serviço.
  rule {
    source_labels = ["__meta_docker_container_label_coolify_resourceName"]
    target_label  = "service"
  }
}